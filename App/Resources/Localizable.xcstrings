            "state" : "translated",
            "value" : "%@'s birthday"
          }
        }
      }
    },
    "A day with a page gets a small dot on the month page. Hold a finger on a day to open its page." : {
      "comment" : "Footer under the date of a journal page.",
      "extractionState" : "manual",
      "localizations" : {
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μια μέρα με σελίδα έχει μια μικρή κουκκίδα στη σελίδα του μήνα. Κράτα το δάχτυλο πάνω σε μια μέρα για να ανοίξει η σελίδα της."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A day with a page gets a small dot on the month page. Hold a finger on a day to open its page."
